{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jackhuclan/aoi_twin_demo/part-catalog.schema.json",
  "title": "AOI 部件台账",
  "type": "object",
  "required": ["assetVersion", "machine", "parts"],
  "properties": {
    "assetVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "machine": { "type": "string", "minLength": 1 },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["partId", "name", "module", "model"],
        "properties": {
          "partId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "name": { "type": "string", "minLength": 1 },
          "module": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "lod": {
            "type": "object",
            "required": ["l1", "l2"],
            "properties": {
              "l1": { "type": "string" },
              "l2": { "type": "string" }
            }
          },
          "axes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
