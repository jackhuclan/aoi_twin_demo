<Window x:Class="AoiTwin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AoiTwin.App.Views"
        Title="AOI 数字孪生 · 产线复现台"
        Width="1460" Height="860" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏：产品标识 + 阶段说明 + 版本 -->
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                Background="{StaticResource SurfaceBrush}" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="6" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="AOI" FontSize="12" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AOI 数字孪生 · 产线复现台" Style="{StaticResource TitleText}" />
                        <TextBlock Text="M1–M3 ／ 实时映射 · 回放闭环 · 预测分析"
                                   Style="{StaticResource CaptionText}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Version, StringFormat=构建 v{0}}" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Style="{StaticResource NavTabControl}"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="3D 场景">
                <views:TwinView DataContext="{Binding Twin}" />
            </TabItem>
            <TabItem Header="采集监控">
                <views:CollectionMonitorView DataContext="{Binding Monitor}" />
            </TabItem>
            <TabItem Header="回放调试">
                <views:ReplayView DataContext="{Binding Replay}" />
            </TabItem>
            <TabItem Header="录制管理">
                <views:RecordingManagerView DataContext="{Binding Recordings}" />
            </TabItem>
            <TabItem Header="健康分析">
                <views:HealthAnalyticsView DataContext="{Binding Health}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
