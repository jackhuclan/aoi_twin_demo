<UserControl x:Class="AoiTwin.App.Views.TwinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rend="clr-namespace:AoiTwin.Rendering.Viewport;assembly=AoiTwin.Rendering"
             xmlns:conv="clr-namespace:AoiTwin.App.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 页头：场景状态 / 帧探针 / 视角操作 ===== -->
        <Border Style="{StaticResource Card}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="3D 场景" Style="{StaticResource TitleText}" />
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="3"
                            Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="M1 中模 · Z 轴向上 · 米制"
                                   FontSize="11" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SceneStatusText" Text="空场景：地面网格 + 设备占地轮廓（GLB 资产包待接入 T1.4）"
                               FontSize="12.5" FontWeight="SemiBold" />
                    <TextBlock Text="视口坐标系：X 向右 · Y 向前 · Z 向上；原点 = 设备安装基准面中心"
                               Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="帧时间" Style="{StaticResource CaptionText}" FontSize="11" />
                        <TextBlock Text="{Binding FrameProbeText, ElementName=Viewport}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="12.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLongFrame, ElementName=Viewport}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Button Content="复位视角" Style="{StaticResource ToolButton}" Click="OnResetViewClick"
                            ToolTip="回到默认等轴测视角（书签切换在 T1.5 接入）" />
                    <Button x:Name="ProbeToggleButton" Content="隐藏帧探针" Style="{StaticResource ToolButton}"
                            Margin="8,0,0,0" Click="OnToggleProbeClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 视口 ===== -->
        <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="6" ClipToBounds="True"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <rend:TwinViewport3D x:Name="Viewport" />
        </Border>
    </Grid>
</UserControl>
