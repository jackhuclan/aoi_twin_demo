<UserControl x:Class="AoiTwin.App.Views.TwinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rend="clr-namespace:AoiTwin.Rendering.Viewport;assembly=AoiTwin.Rendering"
             xmlns:conv="clr-namespace:AoiTwin.App.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 页头：装配状态 / LOD / 帧探针 / 视角与布局操作 ===== -->
        <Border Style="{StaticResource Card}" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="3D 场景" Style="{StaticResource TitleText}" />
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="3"
                            Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="M1 中模 · Z 轴向上 · 米制"
                                   FontSize="11" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="12.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource CaptionText}"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="帧时间" Style="{StaticResource CaptionText}" FontSize="11" />
                        <TextBlock Text="{Binding FrameProbeText, ElementName=Viewport}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="12.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLongFrame, ElementName=Viewport}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="LOD" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                        <ComboBox x:Name="LodCombo" Margin="6,0,0,0" Width="112" SelectedIndex="0"
                                  Style="{StaticResource DarkComboBox}" SelectionChanged="OnLodModeChanged"
                                  ToolTip="细节层次：自动按相机距离在 LOD1/LOD2 间切换（含回滞防闪烁）">
                            <ComboBoxItem Content="自动" />
                            <ComboBoxItem Content="LOD1 近档" />
                            <ComboBoxItem Content="LOD2 远档" />
                        </ComboBox>
                    </StackPanel>

                    <Button Content="复位视角" Style="{StaticResource ToolButton}" Click="OnResetViewClick"
                            Margin="6,0,0,0" ToolTip="回到默认等轴测视角（即时，不做过渡）" />
                    <Button x:Name="FollowButton" Content="跟随载台" Style="{StaticResource ToolButton}"
                            Click="OnFollowClick" Margin="6,0,0,0"
                            ToolTip="视角锁定载台实时追踪（TA.15）；再次点击解除" />
                    <Button Content="重新加载" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                            Command="{Binding ReloadCommand}" ToolTip="重新装配资产包（资产更新后使用）" />
                    <Button x:Name="ProbeToggleButton" Content="隐藏帧探针" Style="{StaticResource ToolButton}"
                            Margin="8,0,0,0" Click="OnToggleProbeClick" />
                    <Button Content="{Binding ImmersiveToggleText}" Style="{StaticResource AccentButton}"
                            Margin="8,0,0,0" Command="{Binding ToggleImmersiveCommand}"
                            ToolTip="沉浸全屏 3D：隐藏右侧面板与书签栏（FR-M1-15，切换 ≤ 1s）" />
                </StackPanel>

                <!-- 装配进度：加载期间才显示 -->
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource MeterBar}"
                             Height="3" Margin="0,9,0,0" Minimum="0" Maximum="100"
                             Value="{Binding ProgressPercent}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- ===== 视角书签（T1.5）：4 预置 + 自定义，切换带 ≤800ms 过渡（沉浸模式下隐藏） ===== -->
        <Border x:Name="BookmarkBar" Grid.Row="1" Style="{StaticResource Card}" Padding="14,8" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="视角" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />

                <ComboBox x:Name="BookmarkCombo" Grid.Column="1" Margin="8,0,0,0" Width="170"
                          Style="{StaticResource DarkComboBox}"
                          ItemsSource="{Binding Bookmarks}"
                          SelectedItem="{Binding SelectedBookmark, Mode=TwoWay}"
                          SelectionChanged="OnBookmarkSelectionChanged"
                          ToolTip="选择预置或自定义视角（切换过渡 ≤ 800ms）">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Grid.Column="2" Margin="8,0,0,0" Width="130" Style="{StaticResource FieldBox}"
                         Text="{Binding NewBookmarkName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="新书签名称（留空自动命名）" />

                <Button Grid.Column="3" Content="保存视角" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                        Click="OnSaveBookmarkClick" ToolTip="把当前相机位姿存为自定义书签" />

                <Button Grid.Column="4" Content="删除" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                        Click="OnDeleteBookmarkClick" ToolTip="删除选中的自定义书签（预置不可删）" />

                <TextBlock Grid.Column="5" Text="{Binding BookmarkHint}" Style="{StaticResource CaptionText}"
                           Margin="14,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- ===== 视口 + 右侧停靠区（T4.1：3D 与 2D 面板共存，可停靠/全屏） ===== -->
        <Grid x:Name="ContentGrid" Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="290" MinWidth="230" MaxWidth="420" />
            </Grid.ColumnDefinitions>

            <Border CornerRadius="6" ClipToBounds="True"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <rend:TwinViewport3D x:Name="Viewport" />
            </Border>

            <GridSplitter x:Name="DockSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" ShowsPreview="False" />

            <Border x:Name="RightDock" Grid.Column="2" CornerRadius="6"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Background="{StaticResource SurfaceBrush}">
                <Grid Margin="12,10,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 分段页签 -->
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="DockTab0" Style="{StaticResource SegmentRadio}" GroupName="RightDock"
                                     Content="部件台账" IsChecked="True" ToolTip="在册部件与选中详情（T1.8）" />
                        <RadioButton x:Name="DockTab1" Style="{StaticResource SegmentRadio}" GroupName="RightDock"
                                     Content="配方树" Margin="4,0,0,0" ToolTip="当前检测配方（M2 接入实时数据）" />
                        <RadioButton x:Name="DockTab2" Style="{StaticResource SegmentRadio}" GroupName="RightDock"
                                     Content="图像映射" Margin="4,0,0,0" ToolTip="缺陷列表：选中即定位 3D 高亮，3D 点选回写列表（TA.14）" />
                        <RadioButton x:Name="DockTab3" Style="{StaticResource SegmentRadio}" GroupName="RightDock"
                                     Content="直方图" Margin="4,0,0,0" ToolTip="缺陷尺寸直方图与光源反射光谱（M3 接入）" />
                        <RadioButton x:Name="DockTab4" Style="{StaticResource SegmentRadio}" GroupName="RightDock"
                                     Content="部件详情" Margin="4,0,0,0" ToolTip="选中部件的实时详情：IO 状态/寿命计数/最近报警（TA.12）" />
                        <RadioButton x:Name="DockTab5" Style="{StaticResource SegmentRadio}" GroupName="RightDock"
                                     Content="诊断" Margin="4,0,0,0" ToolTip="右键 3D 部件跳转对应 2D 诊断页（TA.13）" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <!-- ===== 页签 5：诊断跳转（TA.13 FR-M2-09） ===== -->
                        <Grid Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}, ElementName=DockTab5}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding DiagnosticTitle}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="右键 3D 部件即按类型跳转到对应 2D 诊断页"
                                           FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="10">
                                <ListBox ItemsSource="{Binding DiagnosticLines}" FontSize="11"
                                         Background="Transparent" BorderThickness="0" />
                            </Border>
                        </Grid>

                        <!-- ===== 页签 4：部件详情（TA.12 FR-M2-08） ===== -->
                        <Grid Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}, ElementName=DockTab4}"
                              DataContext="{Binding DrillDown}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding OpticsSummary}" FontSize="11" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="寿命计数：" /><Run Text="{Binding LifeCount, Mode=OneWay}" />
                                    <Run Text="  ·  最近状态：" /><Run Text="{Binding LastStatusAt, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="10">
                                <DockPanel>
                                    <TextBlock Text="IO 状态" DockPanel.Dock="Top" FontSize="12" FontWeight="SemiBold" />
                                    <ListBox ItemsSource="{Binding IoLines}" FontSize="11"
                                             Background="Transparent" BorderThickness="0" />
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="10">
                                <DockPanel>
                                    <TextBlock Text="最近报警" DockPanel.Dock="Top" FontSize="12" FontWeight="SemiBold" />
                                    <ListBox ItemsSource="{Binding Alarms}" FontSize="11"
                                             Background="Transparent" BorderThickness="0" />
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- ===== 页签 0：部件台账（T1.8） ===== -->
                        <Grid Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}, ElementName=DockTab0}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ListBox x:Name="PartList"
                                     Style="{StaticResource PlainListBox}"
                                     ItemsSource="{Binding PartSummaries}"
                                     SelectedItem="{Binding SelectedPartSummary, Mode=TwoWay}"
                                     DisplayMemberPath="Display"
                                     ToolTip="在册部件（点击选中并在 3D 中描边）" />

                            <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,8"
                                    Background="{StaticResource SurfaceAltBrush}" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectionHint}" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{StaticResource AccentBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <ItemsControl ItemsSource="{Binding SelectedPartLines}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11.5" Margin="0,2,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ===== 页签 1：配方树（M1 静态占位，M2 接入实时配方） ===== -->
                        <ScrollViewer Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}, ElementName=DockTab1}"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="4"
                                        Padding="10,7" HorizontalAlignment="Stretch">
                                    <StackPanel>
                                        <TextBlock Text="AOI-M1 · 默认配方" FontWeight="SemiBold" FontSize="12.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="版本 v3 · 生效中 · M2 接入实时下发"
                                                   Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl Margin="0,10,0,0">
                                    <ItemsControl.Items>
                                        <TextBlock Text="├ 检测程序" Style="{StaticResource CaptionText}" />
                                        <TextBlock Text="│   ├ 上料定位 · 已启用" Style="{StaticResource CaptionText}" Margin="14,3,0,0" />
                                        <TextBlock Text="│   └ 高度补偿 · ±0.50 mm" Style="{StaticResource CaptionText}" Margin="14,3,0,0" />
                                        <TextBlock Text="├ 检测项" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                                        <TextBlock Text="│   ├ 焊球桥连 · 0.08 mm²" Style="{StaticResource CaptionText}" Margin="14,3,0,0" />
                                        <TextBlock Text="│   ├ 缺件 · 3 px" Style="{StaticResource CaptionText}" Margin="14,3,0,0" />
                                        <TextBlock Text="│   └ 偏移 · ±0.15 mm" Style="{StaticResource CaptionText}" Margin="14,3,0,0" />
                                        <TextBlock Text="└ 光源方案 · 环形白光 85%" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                                    </ItemsControl.Items>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ===== 页签 2：缺陷列表（TA.14 FR-M2-07 2D/3D 双向联动） ===== -->
                        <Grid Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}, ElementName=DockTab2}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding DefectList.Caption, Mode=OneWay}" Style="{StaticResource CaptionText}"
                                       TextTrimming="CharacterEllipsis" />

                            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="4">
                                <ListBox x:Name="DefectListBox"
                                         ItemsSource="{Binding DefectList.Rows}"
                                         SelectedItem="{Binding DefectList.Selected, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Summary, Mode=OneWay}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Text="列表选中 → 3D 线框高亮；3D 点选缺陷 → 列表定位 + 原图窗口" />
                                <Button x:Name="OpenImageButton" Content="打开原图" Margin="0,6,0,0"
                                        HorizontalAlignment="Left" Padding="12,4"
                                        Style="{StaticResource ToolButton}"
                                        Click="OnOpenImageClick"
                                        ToolTip="按选中缺陷打开原图窗口（M2 为尺寸等比占位图）" />
                            </StackPanel>
                        </Grid>

                        <!-- ===== 页签 3：直方图 / 光谱（M3 接入） ===== -->
                        <Grid Visibility="{Binding IsChecked, Converter={StaticResource BoolToVis}, ElementName=DockTab3}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="缺陷尺寸直方图" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="批次缺陷分布按尺寸分桶统计（M3 接入时序档案）"
                                               Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4"
                                    Padding="10" Margin="0,10,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="光源反射光谱" FontWeight="SemiBold" FontSize="12.5"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="环形光源各波段反射率曲线（M3 接入量测数据）"
                                               Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
