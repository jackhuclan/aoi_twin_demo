<UserControl x:Class="AoiTwin.App.Views.ReplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AoiTwin.App.Converters"
             xmlns:vm="clr-namespace:AoiTwin.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ReplayViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Inverse="True" />

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 工具栏 ===== -->
        <Border Style="{StaticResource Card}" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="打开录制…" Style="{StaticResource AccentButton}" Command="{Binding OpenCommand}" />

                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="变速" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Style="{StaticResource DarkComboBox}" Width="80"
                              ItemsSource="{Binding SpeedOptions}"
                              SelectedItem="{Binding Speed, Mode=TwoWay}" />

                    <Border Width="1" Background="{StaticResource LineBrush}" Margin="14,2" />

                    <Button Content="◀ 上一片" Style="{StaticResource IconButton}" Margin="0,0,8,0"
                            Command="{Binding PrevBatchCommand}" />
                    <Button Content="下一片 ▶" Style="{StaticResource IconButton}" Margin="0,0,8,0"
                            Command="{Binding NextBatchCommand}" />
                    <Button Content="{Binding PlayButtonText}" Style="{StaticResource AccentButton}"
                            Command="{Binding PlayPauseCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主体：批次列表 + 详情 ===== -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="12,12,8,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="2,0,0,8">
                        <TextBlock Text="晶圆批次" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Batches.Count, StringFormat=（{0} 片）}"
                                   Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="6,2,0,0" />
                    </StackPanel>

                    <ListBox Grid.Row="1" Style="{StaticResource PlainListBox}"
                             ItemsSource="{Binding Batches}"
                             SelectedItem="{Binding SelectedBatch, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Display}" FontWeight="SemiBold" FontSize="12.5" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding StartElapsed, StringFormat={}{0:mm\\:ss}}"
                                               Style="{StaticResource MonoText}"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
                <Grid>
                    <!-- 有会话时的详情 -->
                    <Grid Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="回放详情" FontWeight="SemiBold" />
                            <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="3"
                                    Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlayStateText}" FontSize="11"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,16,16">
                                <TextBlock Text="当前批次" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding CurrentBatchText}" Style="{StaticResource FieldValue}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,0,16">
                                <TextBlock Text="批次进度" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding BatchProgressText}" Style="{StaticResource FieldValue}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,0,16,16">
                                <TextBlock Text="帧位置" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding FrameText}" Style="{StaticResource FieldValue}"
                                           FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                                <TextBlock Text="时间轴" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource FieldValue}"
                                           FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,0,16,16">
                                <TextBlock Text="最近消息" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding LastMessageText}" Style="{StaticResource FieldValue}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,16">
                                <TextBlock Text="录制文件" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="{Binding FilePath}" Style="{StaticResource FieldValue}"
                                           FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                           Text="提示：拖动下方时间轴即时定位；点击左侧批次可「按片复查」——从该片首帧开始重演，片尾收到该片的晶圆结果。" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- 空状态 -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasSession, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="尚未加载录制文件" FontSize="15" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="点击「打开录制…」选择 .aotrec，或到「录制管理」页选择已有录制"
                                   Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 时间轴 ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0"
                Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Slider Style="{StaticResource TimelineSlider}"
                        Minimum="0" Maximum="{Binding TotalSeconds}"
                        Value="{Binding PositionSeconds, Mode=TwoWay}"
                        IsEnabled="{Binding HasSession}" />

                <TextBlock Grid.Column="1" Text="{Binding TimeText}" Style="{StaticResource MonoText}"
                           VerticalAlignment="Center" Margin="16,0,2,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
