<UserControl x:Class="AoiTwin.App.Views.HealthAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AoiTwin.App.Converters"
             xmlns:vm="clr-namespace:AoiTwin.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:HealthAnalyticsViewModel}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Inverse="True" />

        <Style x:Key="ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 分数色块：颜色只由等级决定，避免"分数 71 却是绿色"这类口径打架 -->
        <Style x:Key="ScoreBox" TargetType="Border">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Grade}" Value="Good">
                    <Setter Property="BorderBrush" Value="{StaticResource OkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Grade}" Value="Watch">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Grade}" Value="Warning">
                    <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Grade}" Value="Critical">
                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScoreText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Grade}" Value="Good">
                    <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Grade}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Grade}" Value="Critical">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ScoreBar" TargetType="ProgressBar" BasedOn="{StaticResource MeterBar}">
            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Grade}" Value="Watch">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Grade}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Grade}" Value="Critical">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 预警等级点 -->
        <Style x:Key="SeverityDot" TargetType="Ellipse">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource OkBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Alarm">
                    <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 工具栏 ===== -->
        <Border Style="{StaticResource Card}" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="立即分析" Style="{StaticResource AccentButton}"
                            Command="{Binding AnalyzeCommand}" MinWidth="96"
                            ToolTip="读时序库执行全部预测器并发布预警（周期分析默认 5 分钟一轮）" />
                    <Button Content="导出健康档案" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                            Command="{Binding ExportHealthCommand}" ToolTip="CSV，含评分与扣分因子（工程师权限）" />
                    <Button Content="导出预警历史" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                            Command="{Binding ExportAlertsCommand}" ToolTip="JSON，含时间/等级/摘要/提前量/置信度" />
                    <Button Content="数据目录" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                            Command="{Binding OpenStoreFolderCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="预测分析与工艺辅助" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="（分析层为 Hub 普通订阅方，异常不影响实时链路）"
                                   Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="8,2,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding CaliberText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding OptionsSourceText}" Style="{StaticResource CaptionText}"
                               Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="周期调度" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Text="{Binding SchedulerText}" Style="{StaticResource FieldValue}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="上次分析" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Text="{Binding LastRunText}" Style="{StaticResource FieldValue}"
                                   FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="时序存储" Style="{StaticResource ColumnHeader}" />
                        <TextBlock Text="{Binding StoreText}" Style="{StaticResource FieldValue}"
                                   FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 提示条（参数文件无效 / 落盘降级 / 预测器异常） ===== -->
        <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="4" Padding="12,8"
                Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
            <!-- 颜色必须写在 Style 里：本地值优先级高于 Style 触发器，写在属性上会让"降级变红"失效 -->
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#2A2110" />
                    <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNoteError}" Value="True">
                            <Setter Property="Background" Value="#2A1416" />
                            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" Foreground="{StaticResource WarnBrush}" FontSize="13" Margin="0,1,8,0" />
                <TextBlock Text="{Binding NoteText}" Foreground="{StaticResource TextPrimaryBrush}"
                           TextWrapping="Wrap" MaxWidth="1080" />
            </StackPanel>
        </Border>

        <!-- ===== 主体：部件健康 + 因子/预警 ===== -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="部件健康" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Parts.Count, StringFormat=（{0} 个部件，按分数升序）}"
                                   Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="6,2,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,10,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="部件 / 主要扣分项" Style="{StaticResource ColumnHeader}"
                                   Margin="62,0,0,0" />
                        <TextBlock Grid.Column="2" Text="等级" Style="{StaticResource ColumnHeader}"
                                   Width="52" TextAlignment="Right" />
                    </Grid>

                    <ListBox Grid.Row="2" Style="{StaticResource PlainListBox}"
                             ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart}"
                             Visibility="{Binding HasParts, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource ScoreBox}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ScoreText}" Style="{StaticResource ScoreText}" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PartId}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="13" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding TopFactorText}" Style="{StaticResource CaptionText}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Style="{StaticResource ScoreBar}" Value="{Binding Score, Mode=OneWay}"
                                                     Minimum="0" Maximum="100" Margin="0,5,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding GradeText}" Width="52"
                                               TextAlignment="Right" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" Text="{Binding EmptyHint}" Style="{StaticResource CaptionText}"
                               TextWrapping="Wrap" MaxWidth="420" VerticalAlignment="Top"
                               Visibility="{Binding HasParts, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 扣分因子 -->
                <Border Style="{StaticResource Card}" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="扣分因子" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedPart.PartId, StringFormat=· {0}}"
                                       Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="6,2,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="评分 = 100 − 下列扣分之和；权重见 assets/analytics-options.json"
                                   Style="{StaticResource CaptionText}" Margin="0,3,0,8" TextWrapping="Wrap" />

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding SelectedPart.Factors}" MaxHeight="150">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" />
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource CaptionText}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ValueText}"
                                                   Style="{StaticResource MonoText}" FontSize="12"
                                                   Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- 预警时间线 -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="预警时间线" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AlertCountText, StringFormat=（{0}，最近 50 条）}"
                                       Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="6,2,0,0" />
                            <TextBlock Text="{Binding ExportResultText}" Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,2,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="360" />
                        </StackPanel>

                        <ListBox Grid.Row="1" Style="{StaticResource PlainListBox}" ItemsSource="{Binding Alerts}"
                                 Margin="0,8,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource MonoText}"
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Top" Margin="0,2,10,0" />

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource SeverityDot}" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding KindText}" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding PartId}" Style="{StaticResource CaptionText}"
                                                           Margin="6,1,0,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SeverityText}" Style="{StaticResource CaptionText}"
                                                           Margin="6,1,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding MetaText}" Style="{StaticResource MonoText}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Top" Margin="10,2,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 底部：落盘与路径 ===== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="时序落盘" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding PersistenceText}" Style="{StaticResource FieldValue}"
                               FontFamily="{StaticResource MonoFont}" FontSize="12" />
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="{StaticResource LineBrush}" Margin="16,2" />

                <StackPanel Grid.Column="2">
                    <TextBlock Text="存储根目录" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding StorePathText}" Style="{StaticResource FieldValue}" FontSize="11.5"
                               ToolTip="{Binding StorePathText}" />
                </StackPanel>

                <Border Grid.Column="3" Width="1" Background="{StaticResource LineBrush}" Margin="16,2" />

                <StackPanel Grid.Column="4">
                    <TextBlock Text="导出目录" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding ExportPathText}" Style="{StaticResource FieldValue}" FontSize="11.5"
                               ToolTip="{Binding ExportPathText}" />
                </StackPanel>

                <Button Grid.Column="6" Content="打开导出目录" Style="{StaticResource ToolButton}"
                        Command="{Binding OpenExportFolderCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
