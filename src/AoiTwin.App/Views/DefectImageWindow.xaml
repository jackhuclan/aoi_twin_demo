<Window x:Class="AoiTwin.App.Views.DefectImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="缺陷原图"
        Width="452" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}">
    <!--
        缺陷原图窗口（TA.14，FR-M2-07）：
        3D 点选 → 反查 DefectId → 2D 列表定位 → 本窗口。
        M2 阶段原图尚未接入相机档案，用「晶圆裱框 + 缺陷靶心」占位，
        尺寸按 SizeUm 等比缩放（10µm ↔ 60px），保证同一片晶圆上大小关系可读。
    -->
    <StackPanel Margin="18">
        <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" />
        <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0">
            <Run Text="晶圆 " /><Run Text="{Binding WaferId, Mode=OneWay}" /><Run Text="  ·  DefectId " /><Run Text="{Binding DefectId, Mode=OneWay}" />
        </TextBlock>

        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="10">
            <Grid Height="248">
                <Grid.Background>
                    <SolidColorBrush Color="#0A1220" />
                </Grid.Background>

                <!-- 视野裱框 -->
                <Rectangle Stroke="{StaticResource LineBrush}" StrokeThickness="1" RadiusX="3" RadiusY="3" />

                <!-- 缺陷靶心：半径随尺寸等比（10µm = 60px，上限 110px） -->
                <Ellipse Width="{Binding MarkerDiameter}" Height="{Binding MarkerDiameter}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="{StaticResource DangerBrush}" StrokeThickness="1.6" />
                <Ellipse Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{StaticResource DangerBrush}" />
                <Line X1="0" Y1="124" X2="410" Y2="124" Stroke="{StaticResource DangerBrush}"
                      StrokeThickness="0.6" Opacity="0.45" />
                <Line X1="205" Y1="0" X2="205" Y2="248" Stroke="{StaticResource DangerBrush}"
                      StrokeThickness="0.6" Opacity="0.45" />

                <TextBlock Text="原图占位 · 相机档案 M3 接入"
                           Style="{StaticResource CaptionText}" Opacity="0.7"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,6" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="等级" Style="{StaticResource CaptionText}" Margin="0,0,10,6" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DefectClass}" Style="{StaticResource MonoText}" Margin="0,0,16,6" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="尺寸" Style="{StaticResource CaptionText}" Margin="0,0,10,6" />
                <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource MonoText}" Margin="0,0,0,6"
                           Text="{Binding SizeText}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="坐标" Style="{StaticResource CaptionText}" Margin="0,0,10,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PositionText}" Style="{StaticResource MonoText}" Margin="0,0,16,0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="灰度" Style="{StaticResource CaptionText}" Margin="0,0,10,0" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding GrayLevel}" Style="{StaticResource MonoText}" />
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="关闭" Style="{StaticResource ToolButton}" Padding="16,6"
                    Click="OnCloseClick" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
