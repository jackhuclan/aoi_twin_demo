<UserControl x:Class="AoiTwin.App.Views.RecordingManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AoiTwin.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:RecordingManagerViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="RowText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Style="{StaticResource Card}" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="录制目录" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />

                <Border Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        Padding="10,6" Margin="10,0,12,0">
                    <TextBlock Text="{Binding DirectoryPath}" FontFamily="{StaticResource MonoFont}"
                               FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="浏览…" Style="{StaticResource ToolButton}" Margin="0,0,8,0"
                            Command="{Binding BrowseCommand}" />
                    <Button Content="刷新" Style="{StaticResource ToolButton}" Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}" />
                    <Button Content="打开目录" Style="{StaticResource ToolButton}"
                            Command="{Binding OpenFolderCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 文件表 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="文件" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="1" Text="设备" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="2" Text="班次" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="3" Text="开始时间" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="4" Text="时长" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="5" Text="帧数" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="6" Text="状态" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="7" Text="操作" Style="{StaticResource HeaderText}" />
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{StaticResource LineBrush}" Margin="4,0" />

                <ListBox Grid.Row="2" Style="{StaticResource PlainListBox}" Margin="0,4,0,0"
                         ItemsSource="{Binding Files}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource RowText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource CaptionText}"
                                               Margin="0,2,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding DeviceId}" Style="{StaticResource RowText}" />
                                <TextBlock Grid.Column="2" Text="{Binding ShiftId}" Style="{StaticResource RowText}" />
                                <TextBlock Grid.Column="3" Text="{Binding StartedText}" Style="{StaticResource RowText}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                <TextBlock Grid.Column="4" Text="{Binding DurationText}" Style="{StaticResource RowText}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                <TextBlock Grid.Column="5" Text="{Binding FrameCount, StringFormat={}{0:N0}}"
                                           Style="{StaticResource RowText}" FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" />

                                <TextBlock Grid.Column="6" Text="{Binding StateText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RowText}">
                                            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="回放" Style="{StaticResource ToolButton}" Padding="10,3"
                                            Margin="0,0,6,0"
                                            Command="{Binding DataContext.ReplayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="删除" Style="{StaticResource ToolButton}" Padding="10,3"
                                            Foreground="{StaticResource DangerBrush}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding SummaryText}" Style="{StaticResource CaptionText}"
                   Margin="4,10,0,0" />
    </Grid>
</UserControl>
